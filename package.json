{
  "name": "portal-os1-rabbit-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run typecheck && npm run test:coverage && npm run build",
    "test:performance": "node scripts/performance.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.45.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
